# Routax — environment variable reference
# Copy to .env.local and fill in values. Never commit .env or .env.local.

# App
NODE_ENV=development

# Next.js public vars (exposed to browser — prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_APP_URL=https://localhost
NEXT_PUBLIC_API_BASE_URL=/api
# Set to http://localhost:3001 to bypass Caddy and hit the API directly.

# MapTiler — get a free dev key at maptiler.com
NEXT_PUBLIC_MAPTILER_KEY=your_key_here

# API server
API_PORT=3001
WEB_PORT=3000
# Comma-separated browser origins allowed to call the API (CORS). Prefer this name over CORS_ORIGIN
# so host platforms do not treat the value as a literal Access-Control-Allow-Origin header.
# ROUTAX_CORS_ALLOWLIST=https://localhost,https://routax.cc

# Postgres
POSTGRES_USER=routax
POSTGRES_PASSWORD=routax_dev_password
POSTGRES_DB=routax
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=routax_minio
MINIO_ROOT_PASSWORD=routax_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MailHog
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# GraphHopper
GH_PORT=8989
GH_JAVA_OPTS=-Xmx2g -Xms256m
