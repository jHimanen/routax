# Via — environment variable reference
# Copy to .env.local and fill in values. Never commit .env or .env.local.

# App
NODE_ENV=development

# Next.js public vars (exposed to browser — prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MapTiler — get a free dev key at maptiler.com
NEXT_PUBLIC_MAPTILER_API_KEY=your_key_here

# API server
API_PORT=3001

# Postgres
POSTGRES_USER=via
POSTGRES_PASSWORD=via_dev_password
POSTGRES_DB=via
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=via_minio
MINIO_ROOT_PASSWORD=via_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MailHog
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# GraphHopper
GH_PORT=8989
