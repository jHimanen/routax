# Via — environment variable reference
# Copy to .env.local and fill in values. Never commit .env or .env.local.

# App
NODE_ENV=development

# Next.js public vars (exposed to browser — prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MapTiler — get a free dev key at maptiler.com
NEXT_PUBLIC_MAPTILER_API_KEY=your_key_here

# API server
API_PORT=3001
