{
  "name": "@routax/api",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "lint": "biome check ./src",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "flags:set": "tsx scripts/flags.ts set",
    "flags:list": "tsx scripts/flags.ts list",
    "db:migrate": "node scripts/migrate.cjs up",
    "db:migrate:down": "node scripts/migrate.cjs down 1",
    "db:migrate:create": "node-pg-migrate create",
    "db:migrate:status": "node-pg-migrate status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@fastify/cors": "^10.0.0",
    "@routax/shared": "workspace:*",
    "@sentry/node": "^10.50.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.0",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^6.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.0.0",
    "@types/pg": "^8.0.0",
    "dotenv": "^16.0.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
