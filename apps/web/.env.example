# Canonical origin used in deep-link URLs (task 06) and GPX <link> elements (task 08).
# Defaults to window.location.origin when unset.
NEXT_PUBLIC_BASE_URL=https://routax.cc

# Sentry (browser-side — must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_RELEASE=
